{
  "name": "mw-mylove",
  "version": "1.0.0",
  "description": "Flagship Public Web Portal for A-L-L-A-H.COM & MoonWitness Sovereign Ecosystem",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun run --filter @mw/web dev",
    "build": "bun run --filter @mw/web build && bun run --filter @mw/api build",
    "start": "bun run --filter @mw/web start",
    "test": "bun test",
    "typecheck": "bun run --filter @mw/web typecheck && bun run --filter @mw/api typecheck",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "lint:changed": "bun run scripts/lint-changed.ts",
    "check-disables": "bun run scripts/check-disables.ts"
  },
  "devDependencies": {
    "@mw/eslint-config": "workspace:*",
    "@mw/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  }
}
