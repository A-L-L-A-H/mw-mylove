{
  "extends": "@mw/tsconfig/next",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "proxy.ts",
    "next.config.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
